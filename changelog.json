            {
              "id": "a47cac5",
              "scope": "segmented-control",
              "text": "Segmented controls follow the system's reduce motion setting"
            },
            {
              "id": "d45da9d",
              "scope": "connected-button",
              "text": "Screen readers can now switch the dashboard's outbound mode"
            },
            {
              "id": "21846fc",
              "scope": "scaffold",
              "text": "On wider phones the top bar buttons line up with the list cards below them"
            },
            {
              "id": "e3b13e7",
              "scope": "scaffold",
              "text": "Opening search puts the cursor in its field even when something else on the page has the focus"
            },
            {
              "id": "e3ebcf1",
              "scope": "android",
              "text": "App icons in access control and connections load from the cache instead of being redrawn every day"
            },
            {
              "id": "30817b4",
              "scope": "core",
              "text": "On macOS, connections show the app that opened them again"
            },
            {
              "id": "6611671",
              "scope": "window",
              "text": "A hidden window no longer takes the foreground from a full-screen game on Windows"
            },
            {
              "id": "0ff56e5",
              "scope": "linux",
              "text": "The Linux window is no longer drawn shifted toward the bottom left on NVIDIA and other drivers without glBlitFramebuffer"
            },
            {
              "id": "746f7b0",
              "scope": "tray",
              "text": "When the menu bar or tray icon cannot be shown, the log says why"
            },
            {
              "id": "0d3a33f",
              "scope": "macos",
              "text": "Intel Macs render with Skia again, fixing the hang at launch on older GPUs"
            },
            {
              "id": "b16e2db",
              "scope": "dashboard",
              "text": "Service checks show the address Claude and ChatGPT actually saw, not only the node's exit address"
            },
            {
              "id": "80a86bc",
              "scope": "core",
              "text": "Gemini check no longer reports Hong Kong and Macau nodes as unsupported"
            },
            {
              "id": "e7b017e",
              "scope": "core",
              "text": "macOS no longer collects defunct dscacheutil processes each time TUN is turned on or off"
            },
