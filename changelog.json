      "groups": [
        {
          "type": "fix",
          "entries": [
            {
              "id": "4d935ed",
              "scope": "ci,update",
              "text": "Fix release workflow CA certificate bundling, self-update platform matching, and changelog merging"
            },
            {
              "id": "d876766",
              "scope": "config,proxies",
              "text": "Fix inbound listener validation, dialer-proxy cycle checks, node secret redaction, and UI stability issues"
            },
            {
              "id": "5097ebd",
              "scope": "tailscale",
              "text": "Fix Tailscale concurrency races, DERP fallback cleanup, active polling lifecycle, and state reset handling"
            },
            {
              "id": "6107a4f",
              "scope": "backup,routing",
              "text": "Preserve custom routing rules and profile selections across backup and restore, and harden rule validation"
            },
            {
              "id": "db8dec1",
              "scope": "tailscale",
              "text": "Dial every Tailscale DERP relay directly first and fall back to the connection proxy only when direct fails or is blocked"
            }
          ]
        }
      ]
    },
