              "id": "80cc61b",
              "scope": "config",
              "text": "The default bypass list no longer skips the proxy for public 172.2* addresses, and the default fake-ip filter names Windows' real connectivity check hosts"
            },
            {
              "id": "ce13953",
              "scope": "ui",
              "text": "Pages open and close again after the display sleeps or changes"
            },
