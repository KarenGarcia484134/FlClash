      "groups": [
        {
          "type": "fix",
          "entries": [
            {
              "id": "2bbeece",
              "scope": "backup,routing",
              "text": "Prevent profile reload races and apply restored custom routings to Core reliably across all restore modes"
            },
            {
              "id": "4ab8b78",
              "scope": "tailscale",
              "text": "Align Tailscale DERP direct fallback probe timeout with dial budget, back off premature post-read drops, and exclude FlClash TUN interfaces from Tailscale endpoints"
            }
          ]
        }
      ]
    },
    {
      "version": "0.9.32",
